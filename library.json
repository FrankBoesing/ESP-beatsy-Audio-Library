{
  "name": "esp-beatsy-audio-library",
  "version": "0.9.0",
  "description": "ESP32-oriented audio library based on the Teensy Audio Library API.",
  "keywords": [
    "audio",
    "dsp",
    "esp32",
    "teensy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FrankBoesing/ESP-beatsy-Audio-Library.git"
  },
  "homepage": "https://github.com/FrankBoesing/ESP-beatsy-Audio-Library",
  "license": "MIT",
  "authors": [
    {
      "name": "Frank Boesing",
      "maintainer": true
    }
  ],
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "export": {
    "exclude": [
      ".clang-format",
      ".gitattributes",
      ".gitignore",
      "platformio.ini",
      "pio-test",
      "pio-test/*",
      "pio-test/**/*",
      "src/secrets.h",
      "secrets.h",
      "partitions_esp32_p4_wifi6_32MB.csv",
      "sdkconfig.defaults.esp32-p4-wifi6",
      "scripts",
      "scripts/*",
      "scripts/**/*",
      ".vscode",
      ".vscode/*"
    ]
  }
}
