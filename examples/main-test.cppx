#include <Arduino.h>
#include <Wire.h>
#include <driver/i2s_std.h>
#include <math.h>

// ============================================================
// ESP32 Audio Kit V2.2 / ES8388
// ============================================================

// 0 = Philips I2S
// 1 = MSB justified
#define TEST_I2S_FORMAT 0

static constexpr int I2S_BCLK = 27;
static constexpr int I2S_LRCK = 25;
static constexpr int I2S_DOUT = 26;
static constexpr int I2S_MCLK = 0;

static constexpr int I2C_SDA = 33;
static constexpr int I2C_SCL = 32;

static constexpr int PA_ENABLE = 21;

static constexpr uint8_t ES8388_ADDR = 0x10;

static i2s_chan_handle_t txHandle = nullptr;


// ============================================================
// I2C
// ============================================================

bool writeReg(uint8_t reg, uint8_t value)
{
    Wire.beginTransmission(ES8388_ADDR);
    Wire.write(reg);
    Wire.write(value);

    return Wire.endTransmission() == 0;
}

void dumpES8388Registers()
{
    Serial.println();
    Serial.println("=== ES8388 REGISTER DUMP ===");

    for (uint8_t reg = 0; reg <= 0x37; reg++) {

        Wire.beginTransmission(ES8388_ADDR);
        Wire.write(reg);

        if (Wire.endTransmission(false) != 0) {
            Serial.printf(
                "REG 0x%02X : I2C ERROR\n",
                reg
            );
            continue;
        }

        uint8_t count = Wire.requestFrom(
            ES8388_ADDR,
            (uint8_t)1
        );

        if (count != 1) {
            Serial.printf(
                "REG 0x%02X : READ ERROR\n",
                reg
            );
            continue;
        }

        uint8_t value = Wire.read();

        Serial.printf(
            "REG 0x%02X = 0x%02X\n",
            reg,
            value
        );
    }

    Serial.println("============================");
}

// ============================================================
// ES8388 initialization
//
// Based on the ES8388 initialization used by ESP-ADF / the
// AudioKit libraries.
// ============================================================

bool initES8388()
{
    bool ok = true;

    // DAC zunächst muten
    ok &= writeReg(0x19, 0x04);

    // Chip Control
    ok &= writeReg(0x01, 0x50);

    // Chip Power
    ok &= writeReg(0x02, 0x00);

    // ESP32 ist I2S-Master -> ES8388 ist Slave
    ok &= writeReg(0x08, 0x00);

    // DAC Power
    ok &= writeReg(0x04, 0x3E);

    // Control 1
    ok &= writeReg(0x00, 0x12);

    // DAC: 16 Bit, I2S, MCLK/FS = 256
    ok &= writeReg(0x17, 0x18);
    ok &= writeReg(0x18, 0x02);

    // DAC routing
    ok &= writeReg(0x26, 0x1B);
    ok &= writeReg(0x27, 0x90);
    ok &= writeReg(0x2A, 0x90);
    ok &= writeReg(0x2B, 0x80);
    ok &= writeReg(0x2D, 0x00);

    // DAC main volume
    ok &= writeReg(0x1B, 0x00);
    ok &= writeReg(0x1A, 0x00);

    // Output volume
    ok &= writeReg(0x2E, 0x1E);
    ok &= writeReg(0x2F, 0x1E);
    ok &= writeReg(0x30, 0x1E);
    ok &= writeReg(0x31, 0x1E);

    // DAC einschalten
    ok &= writeReg(0x04, 0x3C);

    // DAC unmute
    ok &= writeReg(0x19, 0x00);

    return ok;
}

// ============================================================
// I2S initialization
// ============================================================

bool initI2S()
{
    i2s_chan_config_t chan_cfg = {};

    chan_cfg.id = I2S_NUM_AUTO;
    chan_cfg.role = I2S_ROLE_MASTER;

    chan_cfg.dma_desc_num = 16;
    chan_cfg.dma_frame_num = 256;

    chan_cfg.auto_clear = true;
    chan_cfg.allow_pd = false;
    chan_cfg.intr_priority = 2;

    esp_err_t err =
        i2s_new_channel(
            &chan_cfg,
            &txHandle,
            nullptr
        );

    if (err != ESP_OK) {
        Serial.printf(
            "i2s_new_channel failed: %s\n",
            esp_err_to_name(err)
        );

        return false;
    }

i2s_std_config_t cfg;

memset(&cfg, 0, sizeof(cfg));

cfg.clk_cfg.sample_rate_hz = 44100;
cfg.clk_cfg.clk_src = I2S_CLK_SRC_DEFAULT;
cfg.clk_cfg.mclk_multiple = I2S_MCLK_MULTIPLE_256;

cfg.slot_cfg =
    I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(
        I2S_DATA_BIT_WIDTH_32BIT,
        I2S_SLOT_MODE_STEREO
    );

cfg.gpio_cfg.bclk = GPIO_NUM_27;
cfg.gpio_cfg.ws   = GPIO_NUM_25;
cfg.gpio_cfg.dout = GPIO_NUM_26;
cfg.gpio_cfg.din  = I2S_GPIO_UNUSED;
cfg.gpio_cfg.mclk = GPIO_NUM_0;

cfg.gpio_cfg.invert_flags.mclk_inv = false;
cfg.gpio_cfg.invert_flags.bclk_inv = false;
cfg.gpio_cfg.invert_flags.ws_inv   = false;
    // --------------------------------------------------------
    // GPIO
    // --------------------------------------------------------

    cfg.gpio_cfg.bclk =
        (gpio_num_t)(I2S_BCLK);

    cfg.gpio_cfg.ws =
        (gpio_num_t)(I2S_LRCK);

    cfg.gpio_cfg.dout =
        (gpio_num_t)(I2S_DOUT);

    cfg.gpio_cfg.din =
        I2S_GPIO_UNUSED;

    cfg.gpio_cfg.mclk =
        (gpio_num_t)(I2S_MCLK);

    cfg.gpio_cfg.invert_flags.mclk_inv = false;
    cfg.gpio_cfg.invert_flags.bclk_inv = false;
    cfg.gpio_cfg.invert_flags.ws_inv = false;

    err =
        i2s_channel_init_std_mode(
            txHandle,
            &cfg
        );

    if (err != ESP_OK) {

        Serial.printf(
            "i2s_channel_init_std_mode failed: %s\n",
            esp_err_to_name(err)
        );

        i2s_del_channel(txHandle);
        txHandle = nullptr;

        return false;
    }

    err = i2s_channel_enable(txHandle);

    if (err != ESP_OK) {

        Serial.printf(
            "i2s_channel_enable failed: %s\n",
            esp_err_to_name(err)
        );

        i2s_del_channel(txHandle);
        txHandle = nullptr;

        return false;
    }

    return true;
}


// ============================================================
// 440 Hz sine
// ============================================================

void writeTone()
{
    static float phase = 0.0f;

    constexpr float sampleRate = 44100.0f;
    constexpr float frequency  = 440.0f;

    constexpr size_t samples = 256;

    static int32_t buffer[samples * 2];

    for (size_t i = 0; i < samples; ++i) {

        const float value =
            sinf(phase) * 0.25f;

        // 16-Bit Nutzdaten linksbündig
        // in einem 32-Bit-I²S-Slot.
        const int32_t sample =
            (int32_t)(
                value * 32767.0f
            ) << 16;

        buffer[i * 2]     = sample;
        buffer[i * 2 + 1] = sample;

        phase +=
            2.0f * PI *
            frequency /
            sampleRate;

        if (phase >= 2.0f * PI) {
            phase -= 2.0f * PI;
        }
    }

    size_t written = 0;

    esp_err_t err =
        i2s_channel_write(
            txHandle,
            buffer,
            sizeof(buffer),
            &written,
            100
        );

    if (err != ESP_OK) {

        Serial.printf(
            "I2S write failed: %s\n",
            esp_err_to_name(err)
        );

        return;
    }

    static uint32_t counter = 0;

    if ((counter++ % 100) == 0) {
        Serial.printf(
            "I2S write: requested=%u written=%u\n",
            (unsigned)sizeof(buffer),
            (unsigned)written
        );
    }
}


// ============================================================
// setup
// ============================================================

void setup()
{
    Serial.begin(115200);

    delay(1000);

    Serial.println();
    Serial.println();
    Serial.println("================================");
    Serial.println(" DIRECT ES8388 TEST");
    Serial.println("================================");

    // --------------------------------------------------------
    // I2C
    // --------------------------------------------------------

    Wire.begin(
        I2C_SDA,
        I2C_SCL,
        100000
    );

    Serial.println("I2C initialized");

    // --------------------------------------------------------
    // ES8388
    // --------------------------------------------------------

    Serial.println("Initializing ES8388...");

    if (!initES8388()) {

        Serial.println(
            "ERROR: ES8388 initialization failed"
        );

        return;
    }

    Serial.println(
        "ES8388 initialized"
    );

    // --------------------------------------------------------
    // Power amplifier
    // --------------------------------------------------------

    pinMode(
        PA_ENABLE,
        OUTPUT
    );

    digitalWrite(
        PA_ENABLE,
        HIGH
    );

    Serial.printf(
        "PA_EN GPIO%d = %d\n",
        PA_ENABLE,
        digitalRead(PA_ENABLE)
    );

    // --------------------------------------------------------
    // I2S
    // --------------------------------------------------------

    Serial.println(
        "Initializing I2S..."
    );

    if (!initI2S()) {

        Serial.println(
            "ERROR: I2S initialization failed"
        );

        return;
    }

    Serial.println(
        "I2S initialized"
    );
dumpES8388Registers();
    Serial.println();
    Serial.println(
        "I2S configuration:"
    );

    Serial.printf(
        "BCLK = GPIO%d\n",
        I2S_BCLK
    );

    Serial.printf(
        "LRCK = GPIO%d\n",
        I2S_LRCK
    );

    Serial.printf(
        "DOUT = GPIO%d\n",
        I2S_DOUT
    );

    Serial.printf(
        "MCLK = GPIO%d\n",
        I2S_MCLK
    );

    Serial.println();
    Serial.println(
        "Playing 440 Hz..."
    );
}


// ============================================================
// loop
// ============================================================

void loop()
{
    if (txHandle != nullptr) {
        writeTone();
    }
}
