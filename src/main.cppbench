/*
 * ESP32 A/B benchmark:
 *
 * A = #pragma GCC unroll 4
 * B = manual 4x unrolling
 *
 * Both variants:
 *   - read int16_t LEFT + RIGHT
 *   - pack into one uint32_t
 *   - write one 32-bit word
 *
 * The benchmark measures real CPU cycles using CCOUNT.
 */

#include <Arduino.h>
#include <stdint.h>
#include <stddef.h>
#include <string.h>

#if __has_include(<esp_cpu.h>)
#include <esp_cpu.h>
#endif

constexpr size_t AUDIO_BLOCK_SAMPLES = 128;
constexpr uint32_t INNER_LOOPS = 20000;
constexpr uint32_t MEASUREMENTS = 11;

alignas(16) static int16_t left[AUDIO_BLOCK_SAMPLES];
alignas(16) static int16_t right[AUDIO_BLOCK_SAMPLES];

alignas(16) static int16_t reference[AUDIO_BLOCK_SAMPLES * 2];

alignas(16) static int16_t bufferA[AUDIO_BLOCK_SAMPLES * 2];
alignas(16) static int16_t bufferB[AUDIO_BLOCK_SAMPLES * 2];

static inline uint32_t readCycleCount()
{
#if __has_include(<esp_cpu.h>)
    return esp_cpu_get_cycle_count();
#elif defined(__XTENSA__)
    uint32_t cycles;
    __asm__ __volatile__("rsr.ccount %0" : "=a"(cycles));
    return cycles;
#else
#error "No supported cycle counter"
#endif
}

static inline void compilerBarrier()
{
    __asm__ __volatile__("" ::: "memory");
}


// ============================================================
// Reference implementation
// ============================================================

__attribute__((noinline))
void interleave_reference(
    const int16_t* left,
    const int16_t* right,
    int16_t* buffer)
{
    for (size_t i = 0; i < AUDIO_BLOCK_SAMPLES; ++i) {
        buffer[2 * i]     = left[i];
        buffer[2 * i + 1] = right[i];
    }
}


// ============================================================
// A: GCC pragma unroll 4
// ============================================================

__attribute__((noinline))
void interleave_pragma4(
    const int16_t* leftInput,
    const int16_t* rightInput,
    int16_t* bufferInput)
{
    const int16_t* __restrict left  = leftInput;
    const int16_t* __restrict right = rightInput;
    uint32_t* __restrict dst =
        (uint32_t*)(bufferInput);

#pragma GCC unroll 4
    for (size_t i = 0; i < AUDIO_BLOCK_SAMPLES; ++i) {
        const uint32_t l = (uint16_t)(left[i]);
        const uint32_t r = (uint16_t)(right[i]);
        dst[i] = l | (r << 16);
    }
}


// ============================================================
// B: Manual 4x unrolling
// ============================================================

__attribute__((noinline))
void interleave_manual4(
    const int16_t* leftInput,
    const int16_t* rightInput,
    int16_t* bufferInput)
{
    const int16_t* __restrict left  = leftInput;
    const int16_t* __restrict right = rightInput;
    uint32_t* __restrict dst =
        (uint32_t*)(bufferInput);

    for (size_t i = 0; i < AUDIO_BLOCK_SAMPLES; i += 4) {
        const uint32_t l0 = (uint16_t)(left[i + 0]);
        const uint32_t r0 = (uint16_t)(right[i + 0]);
        dst[i + 0] = l0 | (r0 << 16);

        const uint32_t l1 = (uint16_t)(left[i + 1]);
        const uint32_t r1 = (uint16_t)(right[i + 1]);
        dst[i + 1] = l1 | (r1 << 16);

        const uint32_t l2 = (uint16_t)(left[i + 2]);
        const uint32_t r2 = (uint16_t)(right[i + 2]);
        dst[i + 2] = l2 | (r2 << 16);

        const uint32_t l3 = (uint16_t)(left[i + 3]);
        const uint32_t r3 = (uint16_t)(right[i + 3]);
        dst[i + 3] = l3 | (r3 << 16);
    }
}


// ============================================================
// Optional control: plain loop, same 32-bit store,
// no unrolling directive.
// ============================================================

__attribute__((noinline))
void interleave_no_unroll(
    const int16_t* leftInput,
    const int16_t* rightInput,
    int16_t* bufferInput)
{
    const int16_t* __restrict left  = leftInput;
    const int16_t* __restrict right = rightInput;
    uint32_t* __restrict dst =
        (uint32_t*)(bufferInput);

    for (size_t i = 0; i < AUDIO_BLOCK_SAMPLES; ++i) {
        const uint32_t l = (uint16_t)(left[i]);
        const uint32_t r = (uint16_t)(right[i]);
        dst[i] = l | (r << 16);
    }
}


// ============================================================
// Correctness
// ============================================================

static bool compareBuffer(
    const int16_t* a,
    const int16_t* b)
{
    return memcmp(
        a,
        b,
        AUDIO_BLOCK_SAMPLES * 2 * sizeof(int16_t)) == 0;
}

static bool check16(
    const char* name,
    void (*fn)(const int16_t*, const int16_t*, int16_t*),
    int16_t* out)
{
    memset(out, 0xA5, sizeof(bufferA));
    compilerBarrier();

    fn(left, right, out);

    compilerBarrier();

    const bool ok = compareBuffer(reference, out);

    Serial.printf(
        "%-24s : %s\n",
        name,
        ok ? "OK" : "ERROR");

    return ok;
}


// ============================================================
// Benchmark
// ============================================================

struct Stats {
    uint32_t min;
    uint32_t median;
    uint32_t average;
};

static uint32_t medianOf(
    uint32_t* values,
    size_t count)
{
    for (size_t i = 1; i < count; ++i) {
        const uint32_t key = values[i];
        size_t j = i;

        while (j > 0 && values[j - 1] > key) {
            values[j] = values[j - 1];
            --j;
        }

        values[j] = key;
    }

    return values[count / 2];
}

static Stats benchmark(
    void (*fn)(const int16_t*, const int16_t*, int16_t*),
    int16_t* out)
{
    // Warm-up
    fn(left, right, out);
    compilerBarrier();

    uint32_t timings[MEASUREMENTS];

    uint64_t total = 0;
    uint32_t minimum = UINT32_MAX;

    for (uint32_t m = 0; m < MEASUREMENTS; ++m) {
        compilerBarrier();

        const uint32_t start = readCycleCount();

        for (uint32_t n = 0; n < INNER_LOOPS; ++n) {
            fn(left, right, out);
        }

        compilerBarrier();

        const uint32_t end = readCycleCount();
        timings[m] = end - start;

        total += timings[m];

        if (timings[m] < minimum) {
            minimum = timings[m];
        }
    }

    Stats s;
    s.min = minimum;
    s.median = medianOf(timings, MEASUREMENTS);
    s.average = (uint32_t)(
        total / MEASUREMENTS);

    return s;
}

static void printStats(
    const Stats& s)
{
    Serial.printf(
        "  min=%10lu  median=%10lu  avg=%10lu cycles / %lu calls\n",
        (unsigned long)(s.min),
        (unsigned long)(s.median),
        (unsigned long)(s.average),
        (unsigned long)(INNER_LOOPS));

    const double divisor =
        (double)(INNER_LOOPS) *
        (double)(AUDIO_BLOCK_SAMPLES);

    Serial.printf(
        "  min/sample = %.4f cycles\n",
        (double)(s.min) / divisor);

    Serial.printf(
        "  median/sample = %.4f cycles\n",
        (double)(s.median) / divisor);
}


// ============================================================
// Init
// ============================================================

static void initData()
{
    for (size_t i = 0; i < AUDIO_BLOCK_SAMPLES; ++i) {
        // Deterministic, non-trivial data.
        left[i] =
            (int16_t)(i * 73 - 3000);

        right[i] =
            (int16_t)(2500 - i * 41);
    }

    memset(reference, 0, sizeof(reference));
    memset(bufferA, 0, sizeof(bufferA));
    memset(bufferB, 0, sizeof(bufferB));

    interleave_reference(
        left,
        right,
        reference);
}


// ============================================================
// Main benchmark
// ============================================================

static void runBenchmark()
{
    Serial.println();
    Serial.println("==============================================");
    Serial.println(" ESP32 A/B: GCC unroll 4 vs manual 4x");
    Serial.println("==============================================");

#if defined(CONFIG_IDF_TARGET_ESP32)
    Serial.println("Target: ESP32");
#elif defined(CONFIG_IDF_TARGET_ESP32S2)
    Serial.println("Target: ESP32-S2");
#elif defined(CONFIG_IDF_TARGET_ESP32S3)
    Serial.println("Target: ESP32-S3");
#elif defined(CONFIG_IDF_TARGET_ESP32C3)
    Serial.println("Target: ESP32-C3");
#elif defined(CONFIG_IDF_TARGET_ESP32C6)
    Serial.println("Target: ESP32-C6");
#else
    Serial.println("Target: unknown");
#endif

    Serial.printf(
        "CPU: %lu MHz\n",
        (unsigned long)(ESP.getCpuFreqMHz()));

    Serial.printf(
        "AUDIO_BLOCK_SAMPLES: %lu\n",
        (unsigned long)(AUDIO_BLOCK_SAMPLES));

    Serial.printf(
        "INNER_LOOPS: %lu\n",
        (unsigned long)(INNER_LOOPS));

    Serial.printf(
        "MEASUREMENTS: %lu\n",
        (unsigned long)(MEASUREMENTS));

    initData();

    Serial.println();
    Serial.println("Correctness:");

    bool ok = true;

    ok &= check16(
        "A: pragma unroll 4",
        interleave_pragma4,
        bufferA);

    ok &= check16(
        "B: manual 4x",
        interleave_manual4,
        bufferB);

    ok &= check16(
        "Control: no unroll",
        interleave_no_unroll,
        bufferA);

    if (!ok) {
        Serial.println("ERROR: correctness check failed.");
        return;
    }

    Serial.println();
    Serial.println("Cycle benchmark:");

    Serial.println();
    Serial.println("Control: no unroll");
    const Stats s0 =
        benchmark(interleave_no_unroll, bufferA);
    printStats(s0);

    Serial.println();
    Serial.println("A: #pragma GCC unroll 4");
    const Stats sA =
        benchmark(interleave_pragma4, bufferA);
    printStats(sA);

    Serial.println();
    Serial.println("B: manual 4x");
    const Stats sB =
        benchmark(interleave_manual4, bufferB);
    printStats(sB);

    Serial.println();
    Serial.println("Comparison:");

    const double a =
        (double)(sA.min);

    const double b =
        (double)(sB.min);

    const double control =
        (double)(s0.min);

    Serial.printf(
        "A vs B: %.3f %%\n",
        (a - b) * 100.0 / b);

    Serial.printf(
        "A vs control: %.3f %%\n",
        (a - control) * 100.0 / control);

    Serial.printf(
        "B vs control: %.3f %%\n",
        (b - control) * 100.0 / control);

    Serial.println();
    Serial.println("Done.");
}


void setup()
{
    Serial.begin(115200);
    delay(1000);

    runBenchmark();
}

void loop()
{
    delay(10000);
}
