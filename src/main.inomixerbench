/*
 * AudioMixerN benchmark
 *
 * Compares:
 *
 *   A) CURRENT
 *      sample-outer loop
 *      audio_block_t* + float* gain pointers
 *
 *   B) GEMINI
 *      channel-outer loop
 *      audio_block_t* + float gain values
 *      float accum[] intermediate buffer
 *
 *   C) OPTIMIZED SAMPLE-OUTER
 *      sample-outer loop
 *      direct int16_t* input pointers + float gain values
 *      sum stays in a register candidate
 *
 *   D) OPTIONAL CONTROL
 *      channel-outer loop
 *      direct int16_t* input pointers + float gain values
 *      float accum[]
 *
 *   E) SINGLE INPUT / UNITY GAIN FAST PATH
 *      no mixing, no output allocation equivalent
 *
 * The benchmark deliberately excludes:
 *   - receiveReadOnly()
 *   - block allocation
 *   - block release
 *   - transmit()
 *
 * This isolates the CPU cost of the actual mixing kernel.
 *
 * IMPORTANT:
 *   Build all variants with the same compiler optimization flags.
 *   For comparable numbers, do not change optimization/LTO settings
 *   between ESP32 and ESP32-S3 builds.
 */

#include <Arduino.h>
#include <Audio.h>
#include <esp_cpu.h>

/*
 * Function type used by the benchmark harness.
 *
 * Must be declared before all functions because the Arduino .ino preprocessor
 * may generate automatic prototypes before the original declarations.
 */
using MixFunction = void (*)(unsigned int channels);

#ifndef AUDIO_MIXERN_MAX_INPUTS
#define AUDIO_MIXERN_MAX_INPUTS 32
#endif

static constexpr unsigned int MAX_INPUTS = AUDIO_MIXERN_MAX_INPUTS;
static constexpr unsigned int SAMPLES    = AUDIO_BLOCK_SAMPLES;

/*
 * Number of complete audio blocks processed per benchmark.
 *
 * Increase this when measurements are noisy.
 * 1000 is normally enough to amortize timer/read overhead.
 */
static constexpr unsigned int RUNS = 1000;

/*
 * Warm-up blocks before timing.
 */
static constexpr unsigned int WARMUP_RUNS = 20;

/*
 * Minimal stand-in for the relevant part of audio_block_t.
 *
 * We intentionally keep data[] embedded in the object because the
 * original AudioMixerN uses audio_block_t* and inputs[ch]->data[i].
 */
struct BenchBlock {
    alignas(16) int16_t data[SAMPLES];
};

static BenchBlock g_blocks[MAX_INPUTS];
static BenchBlock g_outBlock;

/*
 * Prepared input/gain arrays.
 *
 * These are initialized BEFORE timing so array construction does not
 * contaminate the mixer-kernel benchmark.
 */
static const BenchBlock *g_blockInputs[MAX_INPUTS];
static const int16_t *g_dataInputs[MAX_INPUTS];

/*
 * Current implementation: activeGains contains pointers to gains[].
 */
static float g_gains[MAX_INPUTS];
static const float *g_gainPointers[MAX_INPUTS];

/*
 * These correspond directly to the arrays built by AudioMixerN::update().
 */
static const BenchBlock *g_activeInputs[MAX_INPUTS];
static const float *g_activeGainPointers[MAX_INPUTS];
static float g_activeGains[MAX_INPUTS];
static const int16_t *g_activeData[MAX_INPUTS];

/*
 * Prevent the compiler from proving the final result unused.
 */
static volatile uint32_t g_sink = 0;

/*
 * --------------------------------------------------------------------------
 * Cycle counter
 * --------------------------------------------------------------------------
 */
static inline uint32_t readCycleCounter()
{
    return esp_cpu_get_cycle_count();
}

/*
 * A tiny memory barrier around benchmark regions.
 */
static inline void compilerBarrier()
{
    asm volatile("" ::: "memory");
}

/*
 * Calculate a deterministic checksum after the timed section.
 *
 * This is NOT part of the timed code.
 */
static uint32_t checksumOutput()
{
    uint32_t sum = 0;

    for (unsigned int i = 0; i < SAMPLES; ++i) {
        sum = (sum * 33u) ^ (uint16_t)g_outBlock.data[i];
    }

    return sum;
}

/*
 * --------------------------------------------------------------------------
 * Test data generation
 * --------------------------------------------------------------------------
 *
 * Deterministic LCG. No random-library overhead.
 */
static uint32_t rngState = 0x12345678u;

static uint32_t fastRand()
{
    rngState = rngState * 1664525u + 1013904223u;
    return rngState;
}

static void prepareData(unsigned int channels)
{
    /*
     * Reset the deterministic generator so every variant sees exactly the
     * same input signal for a given channel count.
     */
    rngState = 0x12345678u ^ (channels * 0x9E3779B9u);

    for (unsigned int ch = 0; ch < channels; ++ch) {
        g_blockInputs[ch] = &g_blocks[ch];
        g_dataInputs[ch]  = g_blocks[ch].data;

        /*
         * Distinct gains prevent the compiler from treating the channels
         * as identical constants.
         *
         * Values are deliberately moderate so that the benchmark represents
         * a normal mixer rather than permanent hard clipping.
         */
        g_gains[ch] = 0.075f + 0.00625f * (float)(ch % 7);

        g_gainPointers[ch] = &g_gains[ch];

        /*
         * Pre-build all active-array representations.
         */
        g_activeInputs[ch] = g_blockInputs[ch];
        g_activeGainPointers[ch] = g_gainPointers[ch];
        g_activeGains[ch] = g_gains[ch];
        g_activeData[ch] = g_dataInputs[ch];

        for (unsigned int i = 0; i < SAMPLES; ++i) {
            /*
             * Full-range-ish audio material with deterministic variation.
             */
            const int32_t v = (int32_t)(fastRand() >> 16) - 32768;
            g_blocks[ch].data[i] = (int16_t)v;
        }
    }

    /*
     * Clear unused entries to avoid accidental dependence on old state.
     */
    for (unsigned int ch = channels; ch < MAX_INPUTS; ++ch) {
        g_blockInputs[ch] = nullptr;
        g_dataInputs[ch]  = nullptr;
        g_gains[ch] = 0.0f;
        g_gainPointers[ch] = nullptr;

        g_activeInputs[ch] = nullptr;
        g_activeGainPointers[ch] = nullptr;
        g_activeGains[ch] = 0.0f;
        g_activeData[ch] = nullptr;
    }

    memset(g_outBlock.data, 0, sizeof(g_outBlock.data));
}

/*
 * --------------------------------------------------------------------------
 * A) Current AudioMixerN hot loop
 * --------------------------------------------------------------------------
 *
 * Equivalent to the original code:
 *
 *   activeGains[channel] = &gains[channel];
 *   sum += inputs[channel]->data[i] * *activeGains[channel];
 */
__attribute__((noinline))
static void mixCurrent(unsigned int channels)
{
    for (unsigned int i = 0; i < SAMPLES; ++i) {
        float sum = 0.0f;

#pragma GCC unroll 4
        for (unsigned int ch = 0; ch < channels; ++ch) {
            sum += (float)g_activeInputs[ch]->data[i] * *g_activeGainPointers[ch];
        }

        if (sum > 32767.0f)
            sum = 32767.0f;
        else if (sum < -32768.0f)
            sum = -32768.0f;

        g_outBlock.data[i] = (int16_t)sum;
    }
}

/*
 * --------------------------------------------------------------------------
 * B) Gemini proposal
 * --------------------------------------------------------------------------
 *
 * Exact algorithmic idea from the proposed code:
 *   - float gain values instead of pointers
 *   - channel-outer loop
 *   - float accum[] intermediate buffer
 */
__attribute__((noinline))
static void mixGemini(unsigned int channels)
{
    /*
     * Exact algorithmic structure of the proposed Gemini version.
     * The active arrays themselves are prepared outside the timed region.
     */
    float accum[SAMPLES];

    const float g0 = g_activeGains[0];
    const int16_t *src0 = g_activeInputs[0]->data;

#pragma GCC unroll 4
    for (unsigned int i = 0; i < SAMPLES; ++i) {
        accum[i] = (float)src0[i] * g0;
    }

    for (unsigned int ch = 1; ch < channels; ++ch) {
        const float g = g_activeGains[ch];
        const int16_t *src = g_activeInputs[ch]->data;

#pragma GCC unroll 4
        for (unsigned int i = 0; i < SAMPLES; ++i) {
            accum[i] += (float)src[i] * g;
        }
    }

#pragma GCC unroll 4
    for (unsigned int i = 0; i < SAMPLES; ++i) {
        float sum = accum[i];

        if (sum > 32767.0f)
            sum = 32767.0f;
        else if (sum < -32768.0f)
            sum = -32768.0f;

        g_outBlock.data[i] = (int16_t)sum;
    }
}

/*
 * --------------------------------------------------------------------------
 * C) Optimized sample-outer variant
 * --------------------------------------------------------------------------
 *
 * Same loop structure as the current version, but:
 *   - gain is stored as float rather than float*
 *   - input data pointer is stored directly
 *
 * This tests whether simply removing the extra indirections is useful,
 * without introducing accum[].
 */
__attribute__((noinline))
static void mixOptimizedSampleOuter(unsigned int channels)
{
    /*
     * Same sample-outer loop as A, but with the extra indirections removed.
     */
    for (unsigned int i = 0; i < SAMPLES; ++i) {
        float sum = 0.0f;

#pragma GCC unroll 4
        for (unsigned int ch = 0; ch < channels; ++ch) {
            sum += (float)g_activeData[ch][i] * g_activeGains[ch];
        }

        if (sum > 32767.0f)
            sum = 32767.0f;
        else if (sum < -32768.0f)
            sum = -32768.0f;

        g_outBlock.data[i] = (int16_t)sum;
    }
}

/*
 * --------------------------------------------------------------------------
 * D) Control: channel-outer + direct data pointers
 * --------------------------------------------------------------------------
 *
 * This isolates the "loop order / accum[]" idea from the audio_block_t
 * indirection.
 */
__attribute__((noinline))
static void mixChannelOuterDirect(unsigned int channels)
{
    /*
     * Same channel-outer/accum[] algorithm as B, but uses direct input
     * pointers. This isolates loop order + accum[] from audio_block_t access.
     */
    float accum[SAMPLES];

    const float g0 = g_activeGains[0];
    const int16_t *src0 = g_activeData[0];

#pragma GCC unroll 4
    for (unsigned int i = 0; i < SAMPLES; ++i) {
        accum[i] = (float)src0[i] * g0;
    }

    for (unsigned int ch = 1; ch < channels; ++ch) {
        const float g = g_activeGains[ch];
        const int16_t *src = g_activeData[ch];

#pragma GCC unroll 4
        for (unsigned int i = 0; i < SAMPLES; ++i) {
            accum[i] += (float)src[i] * g;
        }
    }

#pragma GCC unroll 4
    for (unsigned int i = 0; i < SAMPLES; ++i) {
        float sum = accum[i];

        if (sum > 32767.0f)
            sum = 32767.0f;
        else if (sum < -32768.0f)
            sum = -32768.0f;

        g_outBlock.data[i] = (int16_t)sum;
    }
}

/*
 * --------------------------------------------------------------------------
 * E) Single active input, unity gain
 * --------------------------------------------------------------------------
 */
__attribute__((noinline))
static void mixSingleUnity()
{
    /*
     * The real AudioStream fast path is effectively:
     *
     *   transmit(inputs[0]);
     *   release(inputs[0]);
     *
     * There is no PCM processing and no output block allocation.
     *
     * We therefore deliberately DO NOT memcpy() here; that would measure a
     * copy which the real fast path does not perform.
     */
    const BenchBlock *block = g_activeInputs[0];

    /*
     * Keep the pointer observable without adding meaningful DSP work.
     */
    asm volatile("" : : "r"(block) : "memory");
}

/*
 * --------------------------------------------------------------------------
 * Generic timed benchmark
 * --------------------------------------------------------------------------
 */
using MixFunction = void (*)(unsigned int channels);

static uint32_t benchmarkMixer(MixFunction fn, unsigned int channels)
{
    for (unsigned int i = 0; i < WARMUP_RUNS; ++i) {
        fn(channels);
    }

    compilerBarrier();

    const uint32_t start = readCycleCounter();

    for (unsigned int i = 0; i < RUNS; ++i) {
        fn(channels);
    }

    compilerBarrier();

    const uint32_t elapsed = readCycleCounter() - start;

    /*
     * Consume the result AFTER timing.
     */
    const uint32_t checksum = checksumOutput();
    g_sink ^= checksum;

    return elapsed;
}

static uint32_t benchmarkSingleUnity()
{
    for (unsigned int i = 0; i < WARMUP_RUNS; ++i) {
        mixSingleUnity();
    }

    compilerBarrier();

    const uint32_t start = readCycleCounter();

    for (unsigned int i = 0; i < RUNS; ++i) {
        mixSingleUnity();
    }

    compilerBarrier();

    const uint32_t elapsed = readCycleCounter() - start;

    const uint32_t checksum = checksumOutput();
    g_sink ^= checksum;

    return elapsed;
}

/*
 * Print one result line.
 */
static void printResult(
    const char *name,
    unsigned int channels,
    uint32_t cycles)
{
    const double totalSamples = (double)RUNS * (double)SAMPLES;
    const double cycPerSample = (double)cycles / totalSamples;
    const double cycPerChannel =
        (channels != 0) ? cycPerSample / (double)channels : 0.0;

    Serial.printf(
        "%-24s %2u ch : %10lu cyc total | %8.3f cyc/sample | %8.3f cyc/ch\n",
        name,
        channels,
        (unsigned long)cycles,
        cycPerSample,
        cycPerChannel);
}

static void printHeader()
{
    Serial.println();
    Serial.println(F("=============================================================="));
    Serial.println(F("AudioMixerN benchmark"));
    Serial.println(F("=============================================================="));

#if CONFIG_IDF_TARGET_ESP32S3
    Serial.println(F("Target: ESP32-S3"));
#elif CONFIG_IDF_TARGET_ESP32
    Serial.println(F("Target: ESP32"));
#elif CONFIG_IDF_TARGET_ESP32C3
    Serial.println(F("Target: ESP32-C3"));
#elif CONFIG_IDF_TARGET_ESP32C6
    Serial.println(F("Target: ESP32-C6"));
#elif CONFIG_IDF_TARGET_ESP32P4
    Serial.println(F("Target: ESP32-P4"));
#else
    Serial.println(F("Target: unknown ESP32 variant"));
#endif

    Serial.printf("CPU frequency: %lu MHz\n", (unsigned long)getCpuFrequencyMhz());
    Serial.printf("AUDIO_BLOCK_SAMPLES: %u\n", SAMPLES);
    Serial.printf("Max inputs: %u\n", MAX_INPUTS);
    Serial.printf("Runs: %u\n", RUNS);
    Serial.printf("Warm-up runs: %u\n", WARMUP_RUNS);

    Serial.println();
    Serial.println(F("All variants use identical input data and gains."));
    Serial.println(F("Allocation / receive / release / transmit are NOT measured."));
    Serial.println();
}

void setup()
{
    Serial.begin(115200);
    delay(1000);

    printHeader();

    /*
     * Prepare one common test data set for every channel count.
     */
    const unsigned int channelCounts[] = {1, 2, 4, 8, 16, 32};
    constexpr unsigned int NUM_COUNTS =
        sizeof(channelCounts) / sizeof(channelCounts[0]);

    /*
     * Fast path first.
     */
    prepareData(1);

    const uint32_t fastCycles = benchmarkSingleUnity();

    Serial.println(F("--- Single input / unity fast path ---"));
    Serial.println(F("(DSP kernel cost only; real transmit/release are not included)"));
    printResult("E: single / unity", 1, fastCycles);

    Serial.println();
    Serial.println(F("--- Mixer kernel comparison ---"));

    for (unsigned int n = 0; n < NUM_COUNTS; ++n) {
        const unsigned int channels = channelCounts[n];

        prepareData(channels);

        /*
         * Run each variant with the SAME data set.
         *
         * Re-prepare before each variant so that benchmark order cannot
         * influence the deterministic input state in future modifications.
         */
        const uint32_t a = benchmarkMixer(mixCurrent, channels);

        prepareData(channels);
        const uint32_t b = benchmarkMixer(mixGemini, channels);

        prepareData(channels);
        const uint32_t c = benchmarkMixer(mixOptimizedSampleOuter, channels);

        prepareData(channels);
        const uint32_t d = benchmarkMixer(mixChannelOuterDirect, channels);

        Serial.println();
        Serial.printf("### %u active input(s) ###\n", channels);

        printResult("A: current",            channels, a);
        printResult("B: Gemini accum",       channels, b);
        printResult("C: optimized sample",  channels, c);
        printResult("D: channel-outer",      channels, d);

        /*
         * Relative result to A.
         *
         * Negative percentage = faster than A.
         */
        const double pa = 100.0 * ((double)b / (double)a - 1.0);
        const double pb = 100.0 * ((double)c / (double)a - 1.0);
        const double pc = 100.0 * ((double)d / (double)a - 1.0);

        Serial.printf(
            "Relative to A: B=%+.2f%%  C=%+.2f%%  D=%+.2f%%\n",
            pa, pb, pc);
    }

    Serial.println();
    Serial.println(F("Checksum sink: 0x"));
    Serial.println((unsigned long)g_sink, HEX);

    Serial.println();
    Serial.println(F("Benchmark complete."));
}

void loop()
{
    /*
     * Run once only.
     */
}
