#include <Arduino.h>

#if defined(CONFIG_IDF_TARGET_ARCH_XTENSA)
#include <esp_cpu.h>
#endif

// ============================================================================
// Configuration
// ============================================================================

constexpr int N = 1024;
constexpr int ITERATIONS = 3000;

constexpr int MAX_CHANNELS = 32;

constexpr int TOTAL_SAMPLES = N * ITERATIONS;


// ============================================================================
// Test data
// ============================================================================

alignas(16) int16_t input[MAX_CHANNELS][N];

alignas(16) int16_t outputInt[N];
alignas(16) int16_t outputFloat[N];

alignas(16) int16_t gainsQ15[MAX_CHANNELS];
alignas(16) float   gainsFloat[MAX_CHANNELS];


// Each benchmark has its own observable result.
//
// This prevents the compiler from treating the complete benchmark
// as dead code.
//
// IMPORTANT:
// The result is written only AFTER the timed section.
volatile uint32_t benchmarkResults[64];


// ============================================================================
// Cycle counter
// ============================================================================

static inline uint32_t cycles()
{
#if defined(CONFIG_IDF_TARGET_ARCH_XTENSA)

    uint32_t ccount;

    asm volatile(
        "rsr.ccount %0"
        : "=a"(ccount)
    );

    return ccount;

#else

    return esp_cpu_get_cycle_count();

#endif
}


// ============================================================================
// Prevent compiler from optimizing the complete benchmark away.
//
// The output itself is written to an actual array. After the timed section
// we calculate a checksum and store it in benchmarkResults[].
// ============================================================================

static uint32_t checksum(const int16_t *buffer)
{
    uint32_t result = 0;

    for (int i = 0; i < N; ++i)
        result += (uint16_t)buffer[i];

    return result;
}


// ============================================================================
// Integer saturation
// ============================================================================

static inline int16_t saturate16(int32_t x)
{
    if (x > 32767)
        return 32767;

    if (x < -32768)
        return -32768;

    return (int16_t)x;
}


// ============================================================================
// Float saturation
// ============================================================================

static inline int16_t saturateFloat16(float x)
{
    if (x > 32767.0f)
        return 32767;

    if (x < -32768.0f)
        return -32768;

    return (int16_t)x;
}


// ============================================================================
// Integer mixer
//
// Q15 gain:
//
//     sample * gain
//
//     sample  = signed 16 bit
//     gain    = Q15
//     result  = signed 32 bit
//
// The >> 15 brings the result back to the PCM16 domain.
//
// No saturation is performed here.
// ============================================================================

template<int CHANNELS>
__attribute__((noinline))
void mixIntNoSaturation()
{
    for (int i = 0; i < N; ++i)
    {
        int32_t sum = 0;

        for (int ch = 0; ch < CHANNELS; ++ch)
        {
            sum += ((int32_t)input[ch][i] * gainsQ15[ch]) >> 15;
        }

        outputInt[i] = (int16_t)sum;
    }
}


// ============================================================================
// Integer mixer + saturation
// ============================================================================

template<int CHANNELS>
__attribute__((noinline))
void mixIntSaturated()
{
    for (int i = 0; i < N; ++i)
    {
        int32_t sum = 0;

        for (int ch = 0; ch < CHANNELS; ++ch)
        {
            sum += ((int32_t)input[ch][i] * gainsQ15[ch]) >> 15;
        }

        outputInt[i] = saturate16(sum);
    }
}


// ============================================================================
// Float mixer
//
// Samples remain in PCM16 numerical range.
// Gain is represented as a normal floating-point number.
//
// No saturation.
// ============================================================================

template<int CHANNELS>
__attribute__((noinline))
void mixFloatNoSaturation()
{
    for (int i = 0; i < N; ++i)
    {
        float sum = 0.0f;

        for (int ch = 0; ch < CHANNELS; ++ch)
        {
            sum += (float)input[ch][i] * gainsFloat[ch];
        }

        outputFloat[i] = (int16_t)sum;
    }
}


// ============================================================================
// Float mixer + saturation
// ============================================================================

template<int CHANNELS>
__attribute__((noinline))
void mixFloatSaturated()
{
    for (int i = 0; i < N; ++i)
    {
        float sum = 0.0f;

        for (int ch = 0; ch < CHANNELS; ++ch)
        {
            sum += (float)input[ch][i] * gainsFloat[ch];
        }

        outputFloat[i] = saturateFloat16(sum);
    }
}


// ============================================================================
// Benchmark helper
// ============================================================================

template<typename F>
uint32_t runBenchmark(
    const char *name,
    int channels,
    F function,
    const int16_t *output,
    int resultIndex)
{
    // ------------------------------------------------------------
    // Warm-up
    // ------------------------------------------------------------

    function();

    benchmarkResults[resultIndex] = checksum(output);


    // ------------------------------------------------------------
    // Timed run
    // ------------------------------------------------------------

    uint32_t start = cycles();

    for (int k = 0; k < ITERATIONS; ++k)
    {
        function();
    }

    uint32_t elapsed = cycles() - start;


    // ------------------------------------------------------------
    // Checksum AFTER timing
    // ------------------------------------------------------------

    uint32_t sum = checksum(output);

    benchmarkResults[resultIndex] ^= sum;


    // ------------------------------------------------------------
    // Statistics
    // ------------------------------------------------------------

    const float samples =
        (float)TOTAL_SAMPLES;

    const float cyclesPerSample =
        (float)elapsed / samples;

    const float cyclesPerChannelSample =
        cyclesPerSample / (float)channels;


    Serial.printf(
        "%-38s %10lu cycles  %8.3f cyc/sample  %7.3f cyc/ch\n",
        name,
        (unsigned long)elapsed,
        cyclesPerSample,
        cyclesPerChannelSample
    );

    return elapsed;
}


// ============================================================================
// Run one complete mixer group
// ============================================================================

template<int CHANNELS>
void runMixerGroup(int &index)
{
    char name[64];

    // ------------------------------------------------------------
    // Integer mixer without saturation
    // ------------------------------------------------------------

    snprintf(
        name,
        sizeof(name),
        "INT Q15 %2dch",
        CHANNELS
    );

    runBenchmark(
        name,
        CHANNELS,
        []()
        {
            mixIntNoSaturation<CHANNELS>();
        },
        outputInt,
        index++
    );


    // ------------------------------------------------------------
    // Float mixer without saturation
    // ------------------------------------------------------------

    snprintf(
        name,
        sizeof(name),
        "FLOAT %2dch",
        CHANNELS
    );

    runBenchmark(
        name,
        CHANNELS,
        []()
        {
            mixFloatNoSaturation<CHANNELS>();
        },
        outputFloat,
        index++
    );


    // ------------------------------------------------------------
    // Integer mixer + saturation
    // ------------------------------------------------------------

    snprintf(
        name,
        sizeof(name),
        "INT Q15 %2dch + SAT",
        CHANNELS
    );

    runBenchmark(
        name,
        CHANNELS,
        []()
        {
            mixIntSaturated<CHANNELS>();
        },
        outputInt,
        index++
    );


    // ------------------------------------------------------------
    // Float mixer + saturation
    // ------------------------------------------------------------

    snprintf(
        name,
        sizeof(name),
        "FLOAT %2dch + SAT",
        CHANNELS
    );

    runBenchmark(
        name,
        CHANNELS,
        []()
        {
            mixFloatSaturated<CHANNELS>();
        },
        outputFloat,
        index++
    );
}


// ============================================================================
// Setup
// ============================================================================

void setup()
{
    Serial.begin(115200);

    delay(1000);


    // ========================================================================
    // Initialize test data
    // ========================================================================

    for (int ch = 0; ch < MAX_CHANNELS; ++ch)
    {
        // Different gain for every channel.
        //
        // Range approximately:
        //
        // 0.25 ... 0.95
        //
        // This prevents all channels from becoming identical.

        const float gain =
            0.25f + (0.70f * (float)(ch + 1) / (float)MAX_CHANNELS);

        gainsFloat[ch] = gain;

        gainsQ15[ch] =
            (int16_t)(gain * 32768.0f);


        // Different waveform/data for every channel.
        for (int i = 0; i < N; ++i)
        {
            uint32_t x =
                (uint32_t)(i * 7919)
                + (uint32_t)(ch * 104729);

            x ^= x >> 13;
            x *= 0x5bd1e995;
            x ^= x >> 15;

            input[ch][i] =
                (int16_t)(x & 0xFFFF);
        }
    }


    // Clear output buffers.

    memset(
        outputInt,
        0,
        sizeof(outputInt)
    );

    memset(
        outputFloat,
        0,
        sizeof(outputFloat)
    );


    // ========================================================================
    // Header
    // ========================================================================

    Serial.println();

    Serial.println(
        "=============================================================="
    );

    Serial.println(
        " ESP32 Audio Mixer Integer / Float Benchmark"
    );

    Serial.println(
        "=============================================================="
    );


#if defined(CONFIG_IDF_TARGET_ESP32S3)

    Serial.println("Target: ESP32-S3");

#elif defined(CONFIG_IDF_TARGET_ESP32)

    Serial.println("Target: ESP32");

#elif defined(CONFIG_IDF_TARGET_ESP32C3)

    Serial.println("Target: ESP32-C3");

#elif defined(CONFIG_IDF_TARGET_ESP32C6)

    Serial.println("Target: ESP32-C6");

#else

    Serial.println("Target: other ESP32");

#endif


    Serial.printf(
        "CPU: %lu MHz\n",
        (unsigned long)ESP.getCpuFreqMHz()
    );

    Serial.printf(
        "N: %d\n",
        N
    );

    Serial.printf(
        "Iterations: %d\n",
        ITERATIONS
    );

    Serial.printf(
        "Samples/output: %d\n",
        TOTAL_SAMPLES
    );

    Serial.println();

    Serial.println(
        "Columns:"
    );

    Serial.println(
        "  cycles/sample      = complete mixer cost per output sample"
    );

    Serial.println(
        "  cycles/ch          = mixer cost normalized per channel"
    );

    Serial.println();

    Serial.println(
        "=============================================================="
    );

    Serial.println();


    // ========================================================================
    // Mixer benchmarks
    // ========================================================================

    int index = 0;

    runMixerGroup<1>(index);

    runMixerGroup<2>(index);

    runMixerGroup<4>(index);

    runMixerGroup<8>(index);

    runMixerGroup<16>(index);

    runMixerGroup<32>(index);


    // ========================================================================
    // Result
    // ========================================================================

    Serial.println();

    Serial.println(
        "=============================================================="
    );

    Serial.println("Done.");

    Serial.println();

    Serial.println(
        "Benchmark checksums:"
    );

    for (int i = 0; i < index; ++i)
    {
        Serial.printf(
            "%2d: %08lX\n",
            i,
            (unsigned long)benchmarkResults[i]
        );
    }
}


void loop()
{
}
