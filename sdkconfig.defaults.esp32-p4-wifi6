# ESP-IDF defaults for the Waveshare ESP32-P4-WIFI6 hybrid Arduino + ESP-IDF build.
# This file is selected through SDKCONFIG_DEFAULTS in platformio.ini.
# Delete the generated sdkconfig.esp32-p4-wifi6 when changing these values.

# Arduino-ESP32 requires a 1 kHz FreeRTOS tick rate.
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y

# Arduino's NetworkClientSecure/ssl_client.cpp currently gates its TLS
# implementation on these PSK options. Enable both to provide its symbols.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# ESP32-C6 coprocessor via ESP-Hosted / esp_wifi_remote.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y

# ESP32-P4 external QSPI NOR flash: use quad I/O at runtime.
# esptool/PlatformIO still writes the image header in DIO mode as required
# by the boot flow; the bootloader switches to QIO when this option is enabled.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ESP32-P4NRW32 stacked 32 MB PSRAM.
# Enable the driver itself; selecting HEX mode alone does not enable PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
